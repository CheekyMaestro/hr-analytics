# Set by the Vercel Marketplace Neon integration (`vercel env pull .env.local`).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Random 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REVALIDATE_SECRET=
# https://<project>.vercel.app/api/revalidate (local: http://localhost:3000/api/revalidate)
REVALIDATE_URL=
# Optional
SEED=
NEXT_PUBLIC_REPO_URL=
# Local development without a Postgres server (in-process PGlite):
# DATABASE_URL=pglite:./.data/pglite
# DATABASE_URL_UNPOOLED=pglite:./.data/pglite
